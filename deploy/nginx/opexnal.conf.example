# Copy to /etc/nginx/sites-available/opexnal after replacing domain and certificate paths.
# Obtain TLS certificates first (for example, with Certbot). Do not enable this file
# with placeholder values. The Node/TanStack server should bind to 127.0.0.1:3000.
# This config is a template; it is not deployed by this repository commit.

limit_req_zone $binary_remote_addr zone=opexnal_api:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=opexnal_conn:10m;

upstream opexnal_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name REPLACE_WITH_YOUR_DOMAIN;

    # Certbot can manage this redirect after TLS certificates are provisioned.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name REPLACE_WITH_YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/REPLACE_WITH_YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_YOUR_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 20m;
    limit_conn opexnal_conn 30;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Enable HSTS only after HTTPS is confirmed for every relevant subdomain.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://opexnal_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_redirect off;
    }

    # Rate-limit API routes; tune thresholds after observing real traffic.
    location ~ ^/api/ {
        limit_req zone=opexnal_api burst=30 nodelay;
        proxy_pass http://opexnal_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
