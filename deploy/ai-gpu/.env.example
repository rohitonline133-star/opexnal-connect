# Copy to .env on the GPU server. Never commit the real .env.
OPEX_AI_HF_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
OPEX_AI_MODEL_NAME=opexnal-qwen-7b
OPEX_AI_EMBEDDING_ENDPOINT=http://embeddings:11434
OPEX_AI_EMBEDDING_MODEL=nomic-embed-text
OPEX_AI_MAX_MODEL_LEN=8192
# Generate locally with: openssl rand -hex 32
OPEX_AI_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional for gated Hugging Face models only; keep private.
HF_TOKEN=
